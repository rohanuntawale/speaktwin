# ============================================================
# SpeakTwin - Environment Configuration
# Copy to `.env` and fill in what you need. Every value has a
# working default, so an empty `.env` runs fine (local Whisper,
# no cloud calls).
# ============================================================

# ---- Server ------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
# Comma-separated origins. Use explicit origins in production;
# "*" is fine for local development only.
CORS_ORIGINS=*

# ---- Request limits ---------------------------------------
MAX_UPLOAD_BYTES=10485760
MAX_AUDIO_SECONDS=30
# 0 disables rate limiting entirely
RATE_LIMIT_PER_MINUTE=120
# When set, every /api request must send `X-API-Key: <value>`
# API_KEY=

# ---- Speech-to-text ---------------------------------------
# auto | local | groq | openai
#   auto  -> groq if keyed, else openai if keyed, else local
STT_ENGINE=auto
# GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3
# OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

# Local faster-whisper fallback
WHISPER_MODEL=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Silero VAD trims silence before decoding; reduces hallucination
WHISPER_VAD_FILTER=true

# ---- LLM coaching insight (optional) ----------------------
LLM_ENABLED=true
# OPENROUTER_API_KEY=
# Must be a slug OpenRouter actually serves - an unknown slug makes the
# insight call fail and SpeakTwin falls back to rule-based feedback.
OPENROUTER_MODEL=openai/gpt-5.4
LLM_TIMEOUT_SECONDS=4
# Minimum seconds between LLM calls per session (cost cap)
LLM_MIN_INTERVAL_SECONDS=8
LLM_MAX_TRANSCRIPT_CHARS=1200

# ---- Sessions ---------------------------------------------
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=500
# EMA factor for smoothing per-chunk metrics (0.05-1.0)
SMOOTHING_ALPHA=0.4

# ============================================================
# Deep learning (all OFF by default)
#   pip install -r requirements-ml.txt
# Every flag below is independent: turn on only what you need,
# because each model spends part of the 2.5s chunk budget.
# ============================================================

# Hugging Face token. Needed for gated models (pyannote) and gated
# datasets (Common Voice, TED-LIUM, AMI). Create one at
# https://huggingface.co/settings/tokens
# HF_TOKEN=

# auto | cpu | cuda | mps
ML_DEVICE=auto
# Cap torch intra-op threads so inference does not starve the
# request threadpool. 0 = let torch decide.
ML_TORCH_THREADS=2
# Load enabled models at startup instead of on the first chunk
ML_WARMUP=true

# ---- Neural pitch (CREPE) ---------------------------------
# More reliable than autocorrelation on real speech.
# Measured on CPU: CREPE + Silero together cost ~1.05s of the 2.5s
# chunk budget at `tiny` capacity. `full` is far slower. Enable
# deliberately; a GPU (ML_DEVICE=cuda) changes this substantially.
ML_PITCH_ENABLED=false
ML_CREPE_CAPACITY=tiny
ML_CREPE_CONFIDENCE=0.5

# ---- Voice activity detection (Silero) --------------------
# Replaces the energy gate. Genuinely distinguishes speech from
# noise, so quiet speakers stop being treated as silence.
# First load pulls the model from GitHub via torch.hub.
ML_VAD_ENABLED=false
ML_VAD_THRESHOLD=0.5

# ---- Acoustic filler detection ----------------------------
# Catches the "um"/"uh" that Whisper deletes from transcripts.
# No public checkpoint exists - train one with
# training/train_filler_detector.py, then point this at it.
ML_DISFLUENCY_ENABLED=false
# ML_DISFLUENCY_MODEL=./models/filler-detector
ML_DISFLUENCY_THRESHOLD=0.5

# ---- Speech emotion recognition ---------------------------
ML_EMOTION_ENABLED=false
ML_EMOTION_MODEL=superb/wav2vec2-base-superb-er

# ---- Speaker embeddings (ECAPA-TDNN) ----------------------
# Verifies the same person is still speaking. Cosine similarity below
# the threshold adds a "speaker_changed" warning to the response.
ML_SPEAKER_ENABLED=false
ML_SPEAKER_MODEL=speechbrain/spkrec-ecapa-voxceleb
ML_SPEAKER_THRESHOLD=0.6

# ---- Speaker diarization (pyannote) -----------------------
# Gated: accept the terms at
# https://hf.co/pyannote/speaker-diarization-3.1 and set HF_TOKEN.
ML_DIARIZATION_ENABLED=false
ML_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# ---- Prosody (openSMILE eGeMAPS) --------------------------
ML_PROSODY_ENABLED=false
# Emit all 88 features - useful for building a training set
ML_PROSODY_FULL_VECTOR=false

# ---- Word-level timestamps --------------------------------
# auto | whisperx | whisper_timestamped
ML_ALIGNMENT_ENABLED=false
ML_ALIGNMENT_BACKEND=auto
ML_ALIGNMENT_WHISPER_MODEL=tiny.en
ML_ALIGNMENT_MIN_PAUSE=0.3

# ---- Datasets ---------------------------------------------
# Where scripts/datasets.py stores corpora
SPEAKTWIN_DATA_DIR=data
